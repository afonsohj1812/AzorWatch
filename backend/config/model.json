    },
    {
      "id": "orange",
      "color": "#ff7f3f",
      "rgb": [255, 127, 63, 127],
      "range": "100m - 1km"
    },
    {
      "id": "yellow",
      "color": "#ffff3f",
      "rgb": [255, 255, 63, 127],
      "range": "1km - 10km"
    },
    {
      "id": "none",
      "color": "#dfdfdf",
      "rgb": [0, 0, 0, 0],
      "range": "> 10km"
    }
