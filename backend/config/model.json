{
  "cellSize": 50,
  "forecastDays": 4,

  "classes": {
    "none": { "color": "#dfdfdf", "rgb": [0, 0, 0, 0] },
    "green": { "color": "#3fff9f", "rgb": [63, 255, 159, 127] },
    "yellow": { "color": "#ffff3f", "rgb": [255, 255, 63, 127] },
    "orange": { "color": "#ff7f3f", "rgb": [255, 127, 63, 127] },
    "red": { "color": "#ff3f3f", "rgb": [255, 63, 63, 127] }
  },

  "fog": {
    "cloudBase": { "saturationRh": 90, "lclCoefficient": 125 },
    "cloudTop": { "exitRh": 85, "maxThickness": 1500 },
    "cloudCover": { "minLow": 25 },
    "windward": {
      "aspectTolerance": 60,
      "minSlope": 5,
      "maxLowering": 80,
      "fullEffectWindSpeed": 30,
      "fullEffectSlope": 30
    },

    "lwc": { "adiabaticGradient": 2.0, "subAdiabaticFactor": 0.5 },
    "kunkel": { "coefficient": 144.7, "exponent": 0.88 },
    "mist": { "belowBaseBand": 100 },

    "classThresholds": { "yellow": 10000, "orange": 1000, "red": 100 },
    "summary": { "coverage": { "yellow": 0.25, "orange": 0.5, "red": 0.75 } },

    "surface": {
      "ramp": ["green", "yellow", "orange", "red"],
      "layers": {
        "cloudCover": {
          "source": "cloud_cover_low",
          "label": "Cloud cover",
          "unit": "%",
          "min": 0,
          "max": 100
        }
      }
    },

    "classes": [
      { "id": "red", "label": "10m - 100m" },
      { "id": "orange", "label": "100m - 1km" },
      { "id": "yellow", "label": "1km - 10km" },
      { "id": "none", "label": "> 10km" }
    ]
  },

  "sea": {
    "bandMeters": 1000,

    "layers": {
      "wave": { "weight": 5.0, "perfect": 0.5, "undivable": 2.0 },
      "visibility": {
        "weight": 2.0,
        "perfect": 20,
        "undivable": 4,
        "clear": 30,
        "atOneMeter": 18.6,
        "shoreRange": 1500,
        "shoreWeight": 0.5,
        "minExposure": 0.25,
        "stir": { "weight": 1, "hours": 24, "decay": 0.9 },
        "runoff": { "weight": 2, "hours": 48, "decay": 0.95 },
        "light": { "weight": 0.3, "from": 400, "to": 20 }
      },
      "wind": { "weight": 2.5, "perfect": 0, "undivable": 60 },
      "tide": { "weight": 2.0, "perfect": 0.25, "undivable": 0 }
    },

    "exposure": { "wave": 0.5, "wind": 0.5 },

    "classThresholds": { "green": 0.25, "yellow": 0.5, "orange": 0.75 },
    "summary": { "percentile": 0.5 },
    "neighbors": 3,
    "idwPower": 3,

    "classes": [
      { "id": "red", "label": "Undivable" },
      { "id": "orange", "label": "Marginal" },
      { "id": "yellow", "label": "Divable" },
      { "id": "green", "label": "Perfect" }
    ]
  }
}
