{
  "cellSize": 50,
  "forecastDays": 4,

  "classes": {
    "none": { "color": "#dfdfdf", "rgb": [0, 0, 0, 0] },
    "green": { "color": "#3fff9f", "rgb": [63, 255, 159, 127] },
    "yellow": { "color": "#ffff3f", "rgb": [255, 255, 63, 127] },
    "orange": { "color": "#ff7f3f", "rgb": [255, 127, 63, 127] },
    "red": { "color": "#ff3f3f", "rgb": [255, 63, 63, 127] }
  },

  "fog": {
    "cloudBase": { "saturationRh": 90, "lclCoefficient": 125 },
    "cloudTop": { "exitRh": 85, "maxThickness": 1500 },
    "cloudCover": { "minLow": 25 },
    "windward": {
      "aspectTolerance": 60,
      "minSlope": 5,
      "maxLowering": 80,
      "fullEffectWindSpeed": 30,
      "fullEffectSlope": 30
    },

    "lwc": { "adiabaticGradient": 2.0, "subAdiabaticFactor": 0.5 },
    "kunkel": { "coefficient": 144.7, "exponent": 0.88 },
    "mist": { "belowBaseBand": 100 },

    "classThresholds": { "yellow": 10000, "orange": 1000, "red": 100 },
    "summary": { "coverage": { "yellow": 0.25, "orange": 0.5, "red": 0.75 } },

    "surface": {
      "sampleGridDegrees": 0.0703125,
      "ramp": ["green", "yellow", "orange", "red"],
      "layers": {
        "cloudCover": {
          "source": "cloud_cover_low",
          "label": "Cloud cover",
          "unit": "%",
          "min": 0,
          "max": 100
        }
      }
    },

    "classes": [
      { "id": "red", "label": "10m - 100m" },
      { "id": "orange", "label": "100m - 1km" },
      { "id": "yellow", "label": "1km - 10km" },
      { "id": "none", "label": "> 10km" }
    ]
  },

  "sea": {
    "bandMeters": 1000,
    "sampleGridDegrees": 0.0833333,

    "layers": {
      "wave": { "perfect": 0.3, "undivable": 2.0, "weight": 3.0 },
      "visibility": { "perfect": 0, "undivable": 1, "weight": 2.5 },
      "current": { "perfect": 0.4, "undivable": 2.2, "weight": 2.0 },
      "wind": { "perfect": 8, "undivable": 30, "weight": 1.5 },
      "temperature": { "perfect": 21, "undivable": 15, "weight": 0.5 }
    },

    "turbidity": {
      "stirHours": 12,
      "stirHalfLife": 6,
      "stirWeight": 0.45,
      "waveClear": 0.3,
      "waveMurky": 4.0,

      "chopHours": 8,
      "chopHalfLife": 4,
      "chopWeight": 0.2,
      "chopClear": 0.05,
      "chopMurky": 0.8,

      "runoffHours": 24,
      "runoffHalfLife": 12,
      "runoffWeight": 0.2,
      "rainClear": 0,
      "rainMurky": 10,

      "lightWeight": 0.15,
      "lightClear": 400,
      "lightMurky": 20,

      "clearMeters": 30,
      "murkyMeters": 2
    },

    "shore": { "weight": 0.18, "clearMeters": 600 },

    "classThresholds": { "green": 0.2, "yellow": 0.4, "orange": 0.6 },
    "summary": { "percentile": 0.25 },
    "neighbors": 3,
    "idwPower": 3,

    "classes": [
      { "id": "red", "label": "Undivable" },
      { "id": "orange", "label": "Marginal" },
      { "id": "yellow", "label": "Divable" },
      { "id": "green", "label": "Perfect" }
    ]
  }
}
